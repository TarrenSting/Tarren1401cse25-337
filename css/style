:root {
  --dark-bg: #0A0A0A;
  --charcoal: #1A1A1A;
  --koenigsegg-red: #C8102E;
  --red-hover: #a00d26;
  --light-text: #F5F5F5;
}

/* Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Body */
body {
  font-family: 'Open Sans', sans-serif;
  background-color: #0A0A0A;
  color: #EAEAEA;
  line-height: 1.7;
  scroll-behavior: smooth;
}

/* Headings */
h1,
h2,
h3,
.navbar-brand,
.btn {
  font-family: 'Montserrat', sans-serif;
  font-weight: 700;
}

/* Navbar */
.navbar {
  background-color: rgba(10, 10, 10, 0.95);
  backdrop-filter: blur(12px);
  padding: 1rem 0;
  border-bottom: 1px solid rgba(200, 16, 46, 0.3);
}

.navbar-brand {
  font-weight: 800;
  font-size: 1.7rem;
  color: white !important;
  letter-spacing: 1px;
}

.navbar-brand span {
  color: var(--koenigsegg-red);
}

.nav-link {
  color: #ddd !important;
  font-weight: 500;
  transition: 0.2s;
}

.nav-link:hover,
.nav-link.active {
  color: var(--koenigsegg-red) !important;
}

/* Buttons */
.btn-outline-red {
  border: 1.5px solid var(--koenigsegg-red);
  background: transparent;
  color: white;
  border-radius: 40px;
  padding: 0.4rem 1.2rem;
  font-weight: 600;
  transition: 0.3s;
}

.btn-outline-red:hover {
  background: var(--koenigsegg-red);
  color: white;
  box-shadow: 0 0 12px rgba(200, 16, 46, 0.5);
}

.btn-primary-red {
  background-color: var(--koenigsegg-red);
  border: none;
  padding: 12px 36px;
  border-radius: 50px;
  font-weight: 700;
  transition: 0.2s;
}

.btn-primary-red:hover {
  background-color: var(--red-hover);
  transform: scale(1.02);
}

/* Hero Section */
.hero-home {
  height: 100vh;
  background:
    linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.6),
      rgba(0, 0, 0, 0.5)
    ),
    url('/images/the background.jpg') center/cover no-repeat;

  display: flex;
  align-items: center;
  text-align: center;
}

.hero-inner {
  max-width: 900px;
  margin: 0 auto;
}

.hero-home h1 {
  font-size: 5rem;
  font-weight: 800;
  text-shadow: 2px 2px 20px black;
}

/* Stats Section */
.stats-bar {
  background-color: var(--charcoal);
  padding: 2.5rem 0;
  border-top: 1px solid rgba(200, 16, 46, 0.4);
  border-bottom: 1px solid rgba(200, 16, 46, 0.4);
}

.stat-number {
  font-size: 2.7rem;
  font-weight: 800;
  color: var(--koenigsegg-red);
  font-family: 'Montserrat', sans-serif;
}

/* Section Titles */
.section-title {
  font-size: 2.5rem;
  margin-bottom: 1rem;
  position: relative;
  display: inline-block;
}

.section-title::after {
  content: '';
  width: 70px;
  height: 3px;
  background: var(--koenigsegg-red);
  position: absolute;
  bottom: -12px;
  left: 0;
}

/* General Sections */
.dark-section {
  background: var(--charcoal);
  padding: 4rem 0;
}

/* Car Cards */
.car-card {
  background: #141414;
  border: 1px solid #2a2a2a;
  border-radius: 20px;
  overflow: hidden;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s;
}

.car-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.6);
  border-color: #C8102E;
}

.car-card img {
  height: 220px;
  object-fit: cover;
  width: 100%;
}

.spec-badge {
  background: #1f1f1f;
  color: #C8102E;
  font-weight: 600;
  padding: 0.2rem 0.8rem;
  border-radius: 30px;
  font-size: 0.8rem;
}

/* Footer */
footer {
  background: #050505;
  padding: 2rem 0;
  border-top: 1px solid #222;
}

.footer-link {
  color: #aaa;
  text-decoration: none;
  transition: 0.2s;
}

.footer-link:hover {
  color: var(--koenigsegg-red);
}

.social-icon {
  font-size: 1.6rem;
  margin-right: 1.2rem;
  color: #ccc;
}

.social-icon:hover {
  color: var(--koenigsegg-red);
}

/* Page Header */
.page-header {
  background: linear-gradient(135deg, #0F0F0F, #1A1A1A);
  padding: 140px 0 80px;
  text-align: center;
  border-bottom: 1px solid #C8102E;
}

.page-header h1 {
  font-size: 3.5rem;
}

/* Timeline */
.timeline-item {
  border-left: 2px solid #C8102E;
  padding-left: 1.5rem;
  margin-bottom: 2rem;
}

/* Value Cards */
.value-card {
  background: #111;
  padding: 2rem;
  border-radius: 20px;
  text-align: center;
  transition: 0.2s;
}

.value-card:hover {
  background: #1a1a1a;
}

/* Contact Form */
.contact-form {
  background: #111;
  padding: 2rem;
  border-radius: 24px;
  border: 1px solid #2c2c2c;
}

.form-control,
.form-select {
  background: #1e1e1e;
  border: 1px solid #333;
  color: white;
}

.form-control:focus,
.form-select:focus {
  background: #222;
  border-color: #C8102E;
  box-shadow: 0 0 0 0.25rem rgba(200, 16, 46, 0.25);
}

/* Responsive */
@media (max-width: 768px) {
  .hero-home h1 {
    font-size: 2.8rem;
  }

  .stat-number {
    font-size: 2rem;
  }

  .section-title {
    font-size: 2rem;
  }

  .page-header h1 {
    font-size: 2.2rem;
  }
}
